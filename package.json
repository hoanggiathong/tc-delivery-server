{
  "name": "tc-delivery-server",
  "version": "1.0.0",
  "description": "Express TypeScript API server with JWT authentication",
  "main": "dist/src/index.js",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "cross-env NODE_ENV=development npx tsx watch src/index.ts",
    "dev:debug": "cross-env NODE_ENV=development npx tsx watch --inspect src/index.ts",
    "debug": "cross-env NODE_ENV=development npx tsx --inspect-brk src/index.ts",
    "build": "tsc",
    "build:clean": "rm -rf dist && npm run build",
    "build:prod": "npm run code-quality && npm run build",
    "build:uat": "npm run code-quality && npm run build",
    "start": "cross-env NODE_ENV=production node dist/src/index.js",
    "start:debug": "cross-env NODE_ENV=production node --inspect dist/src/index.js",
    "cronjob:debt:dev": "cross-env NODE_ENV=development npx tsx cronjob/calculate-debt.cronjob.ts",
    "cronjob:debt": "cross-env NODE_ENV=production node dist/cronjob/calculate-debt.cronjob.js",
    "db:sync-indexes": "cross-env NODE_ENV=development npx tsx src/scripts/sync-indexes.ts",
    "db:sync-indexes:prod": "cross-env NODE_ENV=production node dist/src/scripts/sync-indexes.js",
    "db:sync-indexes:uat": "cross-env NODE_ENV=uat node dist/src/scripts/sync-indexes.js",
    "pm2:start:prod": "pm2 start ecosystem.config.js --only tc-delivery-server-prod",
    "pm2:start:uat": "pm2 start ecosystem.config.js --only tc-delivery-server-uat",
    "pm2:start:all": "pm2 start ecosystem.config.js",
    "pm2:stop:prod": "pm2 stop tc-delivery-server-prod",
    "pm2:stop:uat": "pm2 stop tc-delivery-server-uat",
    "pm2:stop:all": "pm2 stop all",
    "pm2:restart:prod": "pm2 restart tc-delivery-server-prod",
    "pm2:restart:uat": "pm2 restart tc-delivery-server-uat",
    "pm2:reload:prod": "pm2 reload tc-delivery-server-prod",
    "pm2:reload:uat": "pm2 reload tc-delivery-server-uat",
    "pm2:delete:prod": "pm2 delete tc-delivery-server-prod",
    "pm2:delete:uat": "pm2 delete tc-delivery-server-uat",
    "pm2:delete:all": "pm2 delete all",
    "pm2:logs:prod": "pm2 logs tc-delivery-server-prod",
    "pm2:logs:uat": "pm2 logs tc-delivery-server-uat",
    "pm2:logs:all": "pm2 logs",
    "pm2:monit": "pm2 monit",
    "deploy:prod": "npm run build:prod && (npm run pm2:restart:prod || npm run pm2:start:prod)",
    "deploy:uat": "npm run build:uat && (npm run pm2:restart:uat || npm run pm2:start:uat)",
    "deploy:force:prod": "npm run build:prod && npm run pm2:delete:prod; npm run pm2:start:prod",
    "deploy:force:uat": "npm run build:uat && npm run pm2:delete:uat; npm run pm2:start:uat",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --fix --ext .ts",
    "format": "prettier --write \"src/**/*.{ts,js,json}\" \"tests/**/*.{ts,js,json}\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\" \"tests/**/*.{ts,js,json}\" \"*.{js,json,md}\"",
    "format:lint": "npm run format && npm run lint:fix",
    "type-check": "tsc --noEmit",
    "code-quality": "npm run type-check && npm run lint && npm run format:check",
    "test": "jest",
    "test:integration": "jest tests/integration",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:debug-file": "node --inspect-brk node_modules/.bin/jest --runInBand --testPathPattern",
    "test:debug-name": "node --inspect-brk node_modules/.bin/jest --runInBand --testNamePattern",
    "test:watch": "jest --watch",
    "test:watch-debug": "node --inspect node_modules/.bin/jest --watch --runInBand",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false"
  },
  "keywords": [
    "express",
    "typescript",
    "jwt",
    "api"
  ],
  "author": "Bao Nguyen",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "module-alias": "^2.2.3",
    "mongoose": "^8.0.3",
    "multer": "^2.0.2",
    "qrcode": "^1.5.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/helmet": "^4.0.0",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.20",
    "@types/module-alias": "^2.0.4",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.0",
    "@types/pdfkit": "^0.17.2",
    "@types/puppeteer": "^5.4.7",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^2.0.16",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.1",
    "prettier": "^3.6.2",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.2"
  }
}
