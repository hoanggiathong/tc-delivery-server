{
  "name": "tc-delivery-server",
  "version": "1.0.0",
  "description": "Express TypeScript API server with JWT authentication",
  "main": "dist/index.js",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "npx tsx watch src/index.ts",
    "dev:debug": "npx tsx watch --inspect src/index.ts",
    "debug": "npx tsx --inspect-brk src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:debug": "node --inspect dist/index.js",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --fix --ext .ts",
    "format": "prettier --write \"src/**/*.{ts,js,json}\" \"tests/**/*.{ts,js,json}\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\" \"tests/**/*.{ts,js,json}\" \"*.{js,json,md}\"",
    "format:lint": "npm run format && npm run lint:fix",
    "type-check": "tsc --noEmit",
    "code-quality": "npm run type-check && npm run lint && npm run format:check",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:debug-file": "node --inspect-brk node_modules/.bin/jest --runInBand --testPathPattern",
    "test:debug-name": "node --inspect-brk node_modules/.bin/jest --runInBand --testNamePattern",
    "test:watch": "jest --watch",
    "test:watch-debug": "node --inspect node_modules/.bin/jest --watch --runInBand",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false"
  },
  "keywords": [
    "express",
    "typescript",
    "jwt",
    "api"
  ],
  "author": "Bao Nguyen",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "canvas": "^3.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsbarcode": "^3.12.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "puppeteer": "^24.17.0",
    "qrcode": "^1.5.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/helmet": "^4.0.0",
    "@types/jest": "^29.5.8",
    "@types/jsbarcode": "^3.11.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.0",
    "@types/puppeteer": "^5.4.7",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^2.0.16",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.1",
    "prettier": "^3.6.2",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.2"
  }
}
